<p><%= link_to "Back", products_path %></p>

<section class="product">
  <%= image_tag @product.featured_image if @product.featured_image.attached? %>

  <section class="product-info">
    <% cache @product do %>
      <h1><%= @product.name %></h1>
      <h4>
        ⭐️ <%= format "%.1f", @product.reviews.average(:star_rating) || 0.0 %>
        (<%=
          link_to pluralize(@product.reviews_count, "review"),
          product_reviews_path(@product)
        %>)
      </h4>
      <%= @product.description %>
    <% end %>

    <%= render "inventory", product: @product %>
    <p>Last updated at: <%= @product.updated_at %></p>

    <%= render "wishlist", product: @product %>

  </section>
</section>
