<h1>Submit a review for <%= @product.name %></h1>

<%= form_with model: [@product, @review] do |form| %>

  <div>
    <fieldset>
      <legend>Star Rating</legend>
      <div class="rating">
        <% 1.upto(5).each do |rating| %>
          <%= form.radio_button :star_rating, rating, required: rating == 1, class: "sr-only" %>
          <%= form.label :"star_rating_#{rating}", "★" %><br>
        <% end %>
      </div>
    </fieldset>
  </div>

  <div>
    <%= form.label :comment %>
    <%= form.textarea :comment %>
  </div>

  <div>
    <%= form.label :images %>
    <%= form.file_field :images, multiple: true, accept: "image/*", capture: "environment" %>
  </div>

  <%= form.submit %>
<% end %>
