<h1>Submit a review for <%= @product.name %></h1>

<%= form_with model: [@product, @review] do |form| %>

  <div>
    <fieldset>
      <legend>Star Rating</legend>

      <% (1..5).each do |rating| %>
        <%= form.radio_button :star_rating, rating, required: rating == 1 %>
        <%= form.label :"star_rating_#{rating}", "#{'★' * rating}#{'☆' * (5 - rating)}" %><br>
      <% end %>
    </fieldset>
  </div>

  <div>
    <%= form.label :comment %>
    <%= form.textarea :comment %>
  </div>

  <%= form.submit %>
<% end %>
